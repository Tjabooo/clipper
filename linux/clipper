# ── recording ────────────────────────────────────────────────────────────────
def gsr_args():
    r = CONF["record"]
    args = ["gpu-screen-recorder", "-w", str(r["window"]), "-f", str(r["fps"]), "-k", str(r["codec"]),
            "-c", "mp4", "-r", str(r["seconds"]), "-ac", "aac", "-o", str(CLIPS), "-ipc", str(SOCKET)]
    if int(r.get("bitrate_kbps") or 0) > 0:
        args += ["-bm", "cbr", "-q", str(int(r["bitrate_kbps"]))]
    else:
        args += ["-q", str(r["quality"])]
    # Track 1 is the mix (what browsers, Discord and phones play); then one track per source,
    # so the trimmer or an editor can rebalance them later.
    if r.get("mix"):
        args += ["-a", "|".join(r["mix"])]
    for source in r.get("tracks") or []:
        args += ["-a", source]
    return args + [str(a) for a in r.get("extra_args") or []]


def set_clip_volumes(pid):
    """[volume] source = percent: clip-only levels, set on gpu-screen-recorder's own capture streams
    (named gsr-<source>), so what you hear live is untouched."""
    wanted = {str(k): v for k, v in (CONF.get("volume") or {}).items()}
    if not wanted or not shutil.which("pactl"):
        return
    for _ in range(10):
        time.sleep(1)
        try:
            outs = json.loads(sh("pactl", "-f", "json", "list", "source-outputs") or "[]")
        except json.JSONDecodeError:
            continue
        mine = [o for o in outs if str(o.get("properties", {}).get("application.process.id")) == str(pid)]
        names = {o["properties"].get("application.name", "") for o in mine}
        if all(f"gsr-{k}" in names for k in wanted):
            for o in mine:
                source = o["properties"].get("application.name", "").removeprefix("gsr-")
                if source in wanted:
                    sh("pactl", "set-source-output-volume", str(o["index"]), f"{int(wanted[source])}%")
            return


def cmd_record():
    """Run gpu-screen-recorder in replay mode until it exits (the service restarts it)."""
    if not shutil.which("gpu-screen-recorder"):
        sys.exit("clipper: gpu-screen-recorder isn't installed")
    CLIPS.mkdir(parents=True, exist_ok=True)
    for _ in range(30):  # PipeWire comes up with the session; wait for it
        if not shutil.which("pactl") or subprocess.run(["pactl", "info"], capture_output=True).returncode == 0:
            break
        time.sleep(1)
    args = gsr_args()
    print("recording:", " ".join(args), flush=True)
    proc = subprocess.Popen(args)
    signal()
    try:
        set_clip_volumes(proc.pid)
        code = proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        code = proc.wait()
    signal()
    sys.exit(code)


def focused_window():
    """{"class", "title"} of the focused window (Hyprland or sway), so the clip is named after the game."""
    out = sh("hyprctl", "activewindow", "-j")
    if out:
        return out
    tree = sh("swaymsg", "-t", "get_tree")
    if tree:
        def walk(n):
            if n.get("focused"):
                return n
            for c in n.get("nodes", []) + n.get("floating_nodes", []):
                if (f := walk(c)):
                    return f
        try:
            f = walk(json.loads(tree)) or {}
            cls = f.get("app_id") or (f.get("window_properties") or {}).get("class") or ""
            return json.dumps({"class": cls, "title": f.get("name") or ""})
        except json.JSONDecodeError:
            pass
    return ""


def cmd_save():
    win = focused_window()   # before saving: you're still in the game
    r = subprocess.run(["gsr-cli", "-ipc", str(SOCKET), "save-replay", str(CONF["record"]["seconds"])],
                       capture_output=True, text=True, timeout=60)
    f = r.stdout.strip().splitlines()[-1] if r.returncode == 0 and r.stdout.strip() else ""
    if not f:
        notify("Clip failed", "Is the replay buffer running? systemctl --user status clipper-replay", "critical")
        sound("warn")
        sys.exit(1)
    cmd_ingest(f, win)   # inline: the keybind's process may be the only thing keeping us alive


def cmd_status():
    running = subprocess.run(["gsr-cli", "-ipc", str(SOCKET), "status"], capture_output=True).returncode == 0
    n = len(pending())
    print(json.dumps({"text": "●", "class": "on" if running else "off",
                      "tooltip": (f"Replay buffer running · {n} to review" if running else "Replay buffer NOT running")}))


def cmd_config():
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(ROOT / "config.example.toml", CONFIG_FILE)
    print(CONFIG_FILE)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    c = a[0]
    if c == "ingest" and len(a) > 1:
        cmd_ingest(a[1], a[2] if len(a) > 2 else "")
    elif c == "record": cmd_record()
    elif c == "save": cmd_save()
    elif c == "status": cmd_status()
    elif c == "config": cmd_config()
    elif c == "list": cmd_list()
    elif c == "stream": cmd_stream()
    elif c == "json": print(json.dumps(snapshot(), indent=1))
    elif c == "count": cmd_count()
    elif c == "toggle": cmd_toggle()
    elif c == "cut" and len(a) >= 4:
        cmd_cut(a[1], a[2], a[3], a[4] if len(a) > 4 else "quality", a[5] if len(a) > 5 else None)
    elif c == "sync":
        cmd_sync(now="--now" in a)
    elif c == "prune":
        cmd_prune(a[1] if len(a) > 1 else None)
    elif c in ("play", "keep", "trim", "share", "discard") and len(a) > 1:
        globals()[f"cmd_{c}"](a[1])
    else:
        sys.exit("clipper: bad command (try `clipper help`)")


if __name__ == "__main__":
    main()
