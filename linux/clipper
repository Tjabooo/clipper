    m = next((m for m in mons if m.get("focused")), None)
    return [x for x in (m.get("model"), m.get("name")) if x] if m else []


def cmd_toggle():
    if eww("ping").stdout.strip() != "pong":
        detached("eww", "-c", str(EWW_CFG), "daemon")
        for _ in range(40):
            time.sleep(0.1)
            if eww("ping").stdout.strip() == "pong":
                break
    if re.search(r"^clipper:|: clipper$|^clipper$", eww("active-windows").stdout, re.M):
        eww("close", "clipper")
        return
    r = None
    for mon in [*focused_monitor(), None]:
        r = eww("open", "clipper", *(["--screen", mon] if mon else []))
        if r.returncode == 0:
            return
    notify("Archive failed to open", (r.stderr or r.stdout).strip()[-300:], "critical")


