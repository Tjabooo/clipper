#!/usr/bin/env python3
"""clipper: a replay buffer and clip archive for Linux (gpu-screen-recorder).

  clipper record                   run the replay buffer (what clipper-replay.service runs)
  clipper save                     save the last [record] seconds, tagged with the focused game
  clipper status                   JSON for a Waybar module: is the replay buffer running?
  clipper list                     clips waiting for review
  clipper toggle                   open/close the review overlay (eww) on the focused monitor
  clipper play|trim|share ID
  clipper keep|discard ID|PATH     PATH = the clip's file (what the trimmer passes)
  clipper cut FILE START END [quality|discord] [NAME]   used by the trimmer
  clipper sync                     move Kept/ and Trimmed Clips/ to [clips] server_dir (verified copy)
  clipper prune [DAYS]             trash unreviewed clips, loose replays and share copies older than
                                   DAYS ([clips] retention_days); Kept/ is never touched
  clipper count | stream | json    data for Waybar / the overlay
  clipper config                   print the config file's path (and create it)

New clips wait in the review queue. keep moves the clip to <dir>/Kept/<game>/, share makes an H.264
copy with all audio tracks mixed into one and copies it for pasting into Discord, trim opens the
mpv trimmer, discard moves it to the trash. Trims go to <dir>/Trimmed Clips/ and are copied too.
Settings: ~/.config/clipper/config.toml (see config.example.toml).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.parse
from datetime import datetime
from pathlib import Path

HOME = Path.home()
ROOT = Path(__file__).resolve().parent
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CONFIG_FILE = Path(os.environ.get("CLIPPER_CONFIG", XDG_CONFIG / "clipper" / "config.toml"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "clipper"
DB = STATE / "clips.json"
THUMBS = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "clipper/thumbs"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
SOCKET = RUNTIME / "clipper-gsr.sock"
TRIM_SCRIPT = ROOT / "trim.lua"

DEFAULTS = {
    "record": {"seconds": 90, "window": "screen", "fps": 60, "codec": "auto", "bitrate_kbps": 0,
               "quality": "very_high", "mix": ["default_output", "default_input"],
               "tracks": ["default_output", "default_input"], "extra_args": []},
    "volume": {},
    "clips": {"dir": "~/Videos/Clips", "retention_days": 1, "trash_days": 7, "discord_mb": 10, "server_dir": ""},
    "ui": {"sounds": True, "waybar_signal": 12, "not_games": []},
}


def load_config():
    conf = {k: dict(v) for k, v in DEFAULTS.items()}
    try:
        user = tomllib.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        user = {}
    except tomllib.TOMLDecodeError as e:
        print(f"clipper: {CONFIG_FILE} is broken ({e}); using defaults", file=sys.stderr)
        user = {}
    for section, values in user.items():
        if isinstance(values, dict):
            conf.setdefault(section, {}).update(values)
    return conf


CONF = load_config()
CLIPS = Path(os.path.expanduser(str(CONF["clips"]["dir"])))
KEPT = CLIPS / "Kept"
EXPORT = CLIPS / "Share"            # SHARE button copies (pruned by retention)
TRIMMED = CLIPS / "Trimmed Clips"   # trimmer exports (never pruned)

# window classes that are never "the game" (you pressed the key while these had focus)
NOT_GAMES = {"alacritty", "kitty", "foot", "wezterm", "org.wezfurlong.wezterm", "discord", "vesktop",
             "firefox", "chromium", "google-chrome", "brave-browser", "thunar", "org.gnome.nautilus",
             "steam", "pavucontrol", "mpv", "obs", "com.obsproject.studio", ""} | \
            {c.lower() for c in CONF["ui"].get("not_games", [])}

SOUNDS = {"saved": "complete", "relay": "message", "warn": "dialog-warning"}


def sound(name):
    """A freedesktop theme sound (or [ui] sound_<name> = "/path/file"), detached; quietly nothing if absent."""
    if not CONF["ui"].get("sounds", True):
        return
    f = CONF["ui"].get(f"sound_{name}")
    if not f:
        for d in ("/usr/share/sounds/freedesktop/stereo",):
            for ext in ("oga", "ogg", "wav"):
                if Path(d, f"{SOUNDS[name]}.{ext}").exists():
                    f = f"{d}/{SOUNDS[name]}.{ext}"
                    break
    player = shutil.which("pw-play") or shutil.which("paplay")
    if f and player and Path(os.path.expanduser(f)).exists():
        detached(player, os.path.expanduser(f))


# ── db ───────────────────────────────────────────────────────────────────────
def load():
    try:
        return json.loads(DB.read_text())
    except (OSError, json.JSONDecodeError):
        return []


def save(clips):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = DB.with_suffix(".tmp")
    tmp.write_text(json.dumps(clips, indent=1))
    tmp.replace(DB)


def find(cid):
    clips = load()
    for c in clips:
        if c["id"] == cid:
            return clips, c
    sys.exit(f"clipper: no clip {cid!r}")


def sh(*cmd, timeout=30):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""


def notify(title, body="", urgency="normal"):
    sh("notify-send", "-a", "Clips", "-u", urgency, title, body)


def detached(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def slug(s):
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-") or "Unknown"


def probe(path):
    out = sh("ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams", str(path))
    try:
        d = json.loads(out)
    except json.JSONDecodeError:
        return {"duration": 0, "audio": 0}
    return {"duration": float(d.get("format", {}).get("duration", 0) or 0),
            "audio": sum(s.get("codec_type") == "audio" for s in d.get("streams", []))}


def game_from_window(win_json):
    try:
        w = json.loads(win_json) if win_json else {}
    except json.JSONDecodeError:
        w = {}
    cls = (w.get("class") or "").strip()
    title = (w.get("title") or "").strip()
    if cls.lower() in NOT_GAMES:
        return "Desktop"
    # Proton games usually have a steam_app_N class and a real title
    if cls.lower().startswith("steam_app_") or not cls:
        return title[:40] or cls or "Unknown"
    return title[:40] if title and len(title) < 40 else cls


def signal():
    """Tell Waybar to refresh the clip modules now ([ui] waybar_signal; 0 = off)."""
    n = int(CONF["ui"].get("waybar_signal") or 0)
    if n:
        subprocess.run(["pkill", f"-RTMIN+{n}", "-x", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── commands ─────────────────────────────────────────────────────────────────
def faststart(p):
    """gsr writes the MP4 index (moov) at the end; move it to the front with a stream copy
    (lossless) so a browser (Marquee's Clips tab) can start a ~1 GB clip without first fetching
    its tail. Low CPU/IO priority; on any failure the original is left as it was."""
    tmp = p.with_name(f".{p.name}.faststart")
    r = subprocess.run(["nice", "-n", "10", "ionice", "-c3", "ffmpeg", "-v", "error", "-y", "-i", str(p),
                        "-map", "0", "-c", "copy", "-movflags", "+faststart", "-f", "mp4", str(tmp)],
                       capture_output=True, text=True)
    try:
        if r.returncode == 0 and tmp.stat().st_size > p.stat().st_size * 0.99:
            os.replace(tmp, p)
    except OSError:
        pass
    tmp.unlink(missing_ok=True)


def cmd_ingest(path, win_json=""):
    p = Path(path)
    # wait until gpu-screen-recorder has finished writing the file
    last = -1
    for _ in range(60):
        try:
            size = p.stat().st_size
        except OSError:
            size = -1
        if size > 0 and size == last:
            break
        last = size
        time.sleep(0.5)
    faststart(p)
    game = game_from_window(win_json)
    info = probe(p)
    clips = load()
    cid = datetime.now().strftime("%m%d-%H%M%S")
    taken = {c["id"] for c in clips}
    base, n = cid, 2
    while cid in taken:
        cid, n = f"{base}-{n}", n + 1
    clip = {"id": cid, "path": str(p), "game": game, "time": time.time(),
            "duration": round(info["duration"]), "tracks": info["audio"],
            "size": p.stat().st_size if p.exists() else 0, "status": "new", "thumb": "",
            "premixed": bool(CONF["record"].get("mix")) and info["audio"] >= 2}
    clips.append(clip)
    save(clips)
    sound("saved")
    notify(f"Clip saved · {game}", f"{clip['duration']} s · {len([c for c in clips if c['status'] == 'new'])} to review")
    signal()

    # thumbnail at low priority so it never competes with the game
    THUMBS.mkdir(parents=True, exist_ok=True)
    thumb = THUMBS / f"{cid}.jpg"
    at = max(0, info["duration"] - 5)  # the moment you pressed the key is at the end
    subprocess.run(["nice", "-n", "19", "ffmpeg", "-v", "error", "-y", "-ss", f"{at:.1f}", "-i", str(p),
                    "-frames:v", "1", "-vf", "scale=320:-2", "-q:v", "4", str(thumb)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if thumb.exists():
        clips = load()
        for c in clips:
            if c["id"] == cid:
                c["thumb"] = str(thumb)
        save(clips)


def ago(ts):
    s = time.time() - ts
    if s < 90:
        return "just now"
    if s < 5400:
        return f"{int(s // 60)} min ago"
    if s < 172800:
        return f"{int(s // 3600)} h ago"
    return f"{int(s // 86400)} d ago"


def pending():
    return [c for c in load() if c["status"] == "new" and Path(c["path"]).exists()]


def cmd_list():
    q = pending()
    if not q:
        print("No clips waiting for review.")
        return
    for c in reversed(q):
        print(f"  {c['id']}  {c['game'][:24]:<24} {c['duration']:>3}s  {ago(c['time']):>12}  {c['path']}")


def placeholder():
    ph = THUMBS / "_none.png"
    if not ph.exists():
        THUMBS.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", "color=c=0x1b1410:s=320x180",
                        "-frames:v", "1", str(ph)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return str(ph)


def snapshot():
    q = list(reversed(pending()))[:6]
    ph = placeholder()
    return {"count": len(pending()),
            "clips": [{"id": c["id"], "game": c["game"], "age": ago(c["time"]),
                       "dur": f"{c['duration']} s",
                       "thumb": c["thumb"] if c.get("thumb") and Path(c["thumb"]).exists() else ph,
                       "tracks": c.get("tracks", 0)} for c in q]}


def cmd_stream():
    last = None
    while True:
        try:
            m = DB.stat().st_mtime if DB.exists() else 0
        except OSError:
            m = 0
        tick = int(time.time() // 30)  # refresh "x min ago" every 30 s
        if (m, tick) != last:
            last = (m, tick)
            try:
                print(json.dumps(snapshot()), flush=True)
            except BrokenPipeError:
                return
        time.sleep(1)


def set_status(cid, status, **extra):
    clips, c = find(cid)
    c["status"] = status
    c.update(extra)
    save(clips)
    signal()
    return c


# clipper records track 1 as the mix of everything ([record] mix; browsers, Discord and phones only
# ever play track 1), then one track per source. Ingest notes that in the clip ("premixed"); clips
# from elsewhere count as premixed with 3+ tracks, else their tracks get mixed when played or shared.
def premixed(n, clip=None):
    if clip and "premixed" in clip:
        return bool(clip["premixed"])
    return n >= 3


def mpv_mix_args(n, clip=None):
    """mpv plays only audio track 1 by default; mix every track so you hear game + friends + you
    (4-track clips already have that mix as track 1)."""
    if n < 2 or premixed(n, clip):
        return []
    ins = "".join(f"[aid{i}]" for i in range(1, n + 1))
    return [f"--lavfi-complex={ins}amix=inputs={n}:normalize=0[ao];[vid1]null[vo]"]


def cmd_play(cid):
    _, c = find(cid)
    n = c.get("tracks") or probe(c["path"])["audio"]
    detached("mpv", "--force-window", "--keep-open=yes", *mpv_mix_args(n, c), c["path"])


def resolve(ref):
    """Clip id, or the clip's file path (the trimmer only knows the path)."""
    if "/" in ref:
        c = clip_for_path(Path(ref))
        return c["id"] if c else None
    return ref


def server_dir():
    v = CONF["clips"].get("server_dir")
    return Path(os.path.expanduser(v)) if v else None


def server_ok(d):
    """Reachable? One stat with a timeout: a sleeping server must never hang us (and each failed
    automount attempt would count towards a Windows account lockout). A network share counts once it
    is mounted; a folder that fstab says is a mount point but isn't mounted doesn't (copying there
    would fill the local disk); any other existing folder is fine."""
    try:
        r = subprocess.run(["timeout", "12", "stat", "-f", "-c", "%T", str(d)],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if r.returncode != 0:
        return False
    if r.stdout.strip() in ("smb2", "cifs", "smb", "nfs", "nfs4", "fuse.sshfs", "fuse"):
        return True
    planned = subprocess.run(["findmnt", "--fstab", "-n", "--mountpoint", str(d)], capture_output=True, text=True)
    return d.is_dir() and not planned.stdout.strip()


def move_verified(src, dest):
    """Copy, fsync, compare sizes, then delete the source. Never loses a clip mid-transfer."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest = unique(dest)
    tmp = dest.with_name(dest.name + ".part")
    with open(src, "rb") as a, open(tmp, "wb") as b:
        shutil.copyfileobj(a, b, 8 << 20)
        b.flush(); os.fsync(b.fileno())
    if tmp.stat().st_size != src.stat().st_size:
        tmp.unlink(missing_ok=True)
        raise OSError(f"size mismatch copying {src.name}")
    tmp.rename(dest)
    src.unlink()
    return dest


def follow_clipboard(old, new):
    """A trim you just copied for Discord moved to the server: re-point the clipboard at it."""
    if not shutil.which("wl-paste"):
        return
    cur = subprocess.run(["wl-paste", "-n", "-t", "text/uri-list"], capture_output=True, text=True).stdout.strip()
    if cur == "file://" + urllib.parse.quote(str(old)):
        subprocess.run(["wl-copy", "-t", "text/uri-list"], input="file://" + urllib.parse.quote(str(new)) + "\n",
                       text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_sync(now=False):
    d = server_dir()
    if not d:
        return
    jobs = [(f, d / "Kept" / f.relative_to(KEPT)) for f in KEPT.rglob("*.mp4")] if KEPT.exists() else []
    if TRIMMED.exists():
        jobs += [(f, d / "Trimmed Clips" / f.name) for f in TRIMMED.glob("*.mp4")]
    if not jobs:
        return
    if not server_ok(d):
        print(f"server share {d} not reachable: {len(jobs)} clip(s) stay local for now")
        return
    clips, moved, size = load(), 0, 0
    for src, dest in jobs:
        try:
            n = src.stat().st_size
            final = move_verified(src, dest)
        except OSError as e:
            print(f"couldn't move {src.name}: {e}")
            continue
        moved += 1; size += n
        follow_clipboard(src, final)
        for c in clips:
            if c.get("path") == str(src):
                c["path"] = str(final)
        for parent in (src.parent,):
            if parent != KEPT and parent.is_relative_to(KEPT) and not any(parent.iterdir()):
                parent.rmdir()
    if moved:
        save(clips)
        print(f"moved {moved} clip(s) to the server · {size / 1e6:.0f} MB")


def cmd_keep(cid):
    ref = cid
    cid = resolve(cid)
    if cid is None:
        print(f"not in the archive, left where it is: {ref}")
        return
    _, c = find(cid)
    if c["status"] == "kept":
        print(f"already kept: {c['path']}")
        return
    src = Path(c["path"])
    dest_dir = KEPT / slug(c["game"])
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / src.name
    shutil.move(str(src), dest)
    set_status(cid, "kept", path=str(dest))
    sound("relay")
    detached(sys.argv[0], "sync")   # off to the home server in the background


def cmd_trim(cid):
    """Native trimmer: mpv with I / O / E / D keys (see trim.lua)."""
    _, c = find(cid)
    n = c.get("tracks") or probe(c["path"])["audio"]
    detached("mpv", "--force-window", "--keep-open=yes", f"--script={TRIM_SCRIPT}",
             f"--script-opts=clipper-discord_mb={discord_mb():g}",
             f"--title=TRIM · {c['game']}", *mpv_mix_args(n, c), c["path"])


def clip_for_path(path):
    want = Path(path).resolve()
    for c in load():
        if c["path"] == str(path) or Path(c["path"]).resolve() == want:
            return c
    return None


def safe_name(text):
    """A user-typed trim name made safe for a filename (keeps spaces, drops / \\ and control chars)."""
    text = re.sub(r"[\x00-\x1f/\\\\:*?\"<>|]+", "-", text or "").strip(" .-")
    return re.sub(r"\s+", " ", text)[:80]


def unique(path):
    """name.mp4 -> name (2).mp4 -> name (3).mp4 … instead of overwriting."""
    n, p = 2, path
    while p.exists():
        p = path.with_name(f"{path.stem} ({n}){path.suffix}"); n += 1
    return p


def export(src, start=None, end=None, mode="quality", dest=EXPORT, title=None):
    """Accurate cut, all audio tracks mixed into one, H.264 so it plays everywhere.

    mode "quality": CRF 20 at full resolution.
    mode "discord": aims for 90 % of Discord's upload limit ([clips] discord_mb, default 10):
    bitrate from the length, resolution stepped down when the bitrate gets thin.
    """
    src = Path(src)
    info = probe(src)
    dur_total = info["duration"] or 0
    s = max(0.0, float(start or 0))
    e = min(float(end), dur_total) if end not in (None, "") else dur_total
    if e - s < 0.5:
        return None, "the cut is shorter than half a second"
    length = e - s
    c = clip_for_path(src)
    name = f"{slug(c['game'])}_{c['id']}" if c else src.stem
    suffix = "" if (s == 0 and e >= dur_total - 0.05) else f"_{int(s)}-{int(e)}s"
    dest.mkdir(parents=True, exist_ok=True)
    limit = discord_mb()
    title = safe_name(title)
    if title:   # your own name from the trimmer prompt; Discord copies still get the size tag
        out = unique(dest / f"{title}{f' ({limit:g}mb)' if mode == 'discord' else ''}.mp4")
    else:
        out = dest / f"{name}{suffix}{f'_{limit:g}mb' if mode == 'discord' else ''}.mp4"

    n = info["audio"]
    cmd = ["nice", "-n", "5", "ffmpeg", "-v", "error", "-y", "-ss", f"{s:.3f}", "-i", str(src),
           "-t", f"{length:.3f}", "-map", "0:v:0"]
    if premixed(n, c):
        cmd += ["-map", "0:a:0"]   # track 1 is already game + friends + you
    elif n >= 2:
        mix = "".join(f"[0:a:{i}]" for i in range(n)) + f"amix=inputs={n}:normalize=0:duration=longest[a]"
        cmd += ["-filter_complex", mix, "-map", "[a]"]
    elif n == 1:
        cmd += ["-map", "0:a:0"]
    if mode == "discord":
        audio_k = 128
        total_k = limit * 0.9 * 8000 / length  # decimal MB → kbit/s; 10 % headroom for overshoot
        video_k = max(250, int(total_k - audio_k))
        height = 1440 if video_k > 9000 else 1080 if video_k > 3500 else 720 if video_k > 1200 else 540
        cmd += ["-vf", f"scale=-2:'min({height},ih)'", "-c:v", "libx264", "-preset", "veryfast",
                "-b:v", f"{video_k}k", "-maxrate", f"{int(video_k * 1.15)}k", "-bufsize", f"{video_k * 2}k"]
    else:
        audio_k = 192
        cmd += ["-c:v", "libx264", "-preset", "veryfast", "-crf", "20"]
    cmd += ["-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", f"{audio_k}k", "-movflags", "+faststart", str(out)]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not out.exists():
        return None, r.stderr.strip()[-300:] or "ffmpeg failed"
    return out, ""


def deliver(out):
    copied = False
    if shutil.which("wl-copy"):
        uri = "file://" + urllib.parse.quote(str(out))  # "Trimmed Clips" has a space
        # wl-copy keeps a child alive to serve the clipboard: detach it from our stdout, or
        # the trimmer (which waits for EOF on it) sits on "exporting…" until the clipboard changes
        p = subprocess.run(["wl-copy", "-t", "text/uri-list"], input=f"{uri}\n", text=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        copied = p.returncode == 0
    mb, limit = out.stat().st_size / 1e6, discord_mb()
    notify("Ready to share" + (" · copied, paste into Discord" if copied else ""),
           f"{out.name} · {mb:.1f} MB" + (f"  (over {limit:g} MB: use D in the trimmer)" if mb > limit else ""))
    sound("saved")
    print(out)


def cmd_cut(path, start, end, mode="quality", title=None):
    out, err = export(path, start, end, mode, dest=TRIMMED, title=title)
    if not out:
        notify("Export failed", err, "critical")
        sound("warn")
        sys.exit(1)
    deliver(out)                        # clipboard first …
    detached(sys.argv[0], "sync")       # … then off to the home server; the clipboard follows it


def cmd_share(cid):
    """The whole clip, all tracks mixed into one, H.264."""
    _, c = find(cid)
    notify("Preparing share copy…", c["game"])
    cmd_cut(c["path"], None, None, "quality")


def to_trash(src):
    src = Path(src)
    if not src.exists():
        return
    if shutil.which("gio") and subprocess.run(["gio", "trash", str(src)]).returncode == 0:
        return
    # gio can't (e.g. /tmp); do what it does: the file plus a .trashinfo, so purges find it later
    trash = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "Trash"
    (trash / "files").mkdir(parents=True, exist_ok=True)
    (trash / "info").mkdir(parents=True, exist_ok=True)
    dest = unique(trash / "files" / src.name)
    (trash / "info" / f"{dest.name}.trashinfo").write_text(
        f"[Trash Info]\nPath={urllib.parse.quote(str(src.resolve()))}\n"
        f"DeletionDate={datetime.now().strftime('%Y-%m-%dT%H:%M:%S')}\n")
    shutil.move(str(src), dest)


def cmd_discard(cid):
    ref = cid
    cid = resolve(cid)
    if cid is None:
        to_trash(ref)  # a loose replay the archive never ingested
        print(f"trashed {ref}")
        return
    _, c = find(cid)
    to_trash(c["path"])
    if c.get("thumb"):
        Path(c["thumb"]).unlink(missing_ok=True)
    set_status(cid, "discarded")


def clips_conf(key, default):
    """A number from [clips], or default if missing/broken."""
    try:
        return float(CONF["clips"].get(key, default))
    except (TypeError, ValueError):
        return float(default)


def retention_days():  # (purge of trashed clips: [clips] trash_days, default 7)
    return clips_conf("retention_days", 1)


def discord_mb():
    return clips_conf("discord_mb", 20)


def purge_trashed_clips(days):
    """Permanently delete clips that sat in the trash for more than `days`.

    Only files whose .trashinfo says they came from the clips folder: nothing else in the trash
    is touched."""
    data = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "Trash"
    cutoff = datetime.now().timestamp() - days * 86400
    n = size = 0
    for info in (data / "info").glob("*.trashinfo"):
        try:
            meta = dict(l.split("=", 1) for l in info.read_text().splitlines() if "=" in l)
            orig = urllib.parse.unquote(meta.get("Path", ""))
            when = datetime.fromisoformat(meta.get("DeletionDate", "")).timestamp()
        except (OSError, ValueError):
            continue
        if not orig.startswith(str(CLIPS) + "/") or when > cutoff:
            continue
        f = data / "files" / info.name.removesuffix(".trashinfo")
        try:
            if f.is_file():
                size += f.stat().st_size
                f.unlink()
            info.unlink()
            n += 1
        except OSError:
            pass
    return n, size


def cmd_prune(days=None):
    days = float(days) if days else retention_days()
    cutoff = time.time() - days * 86400
    gone, size = [], 0
    clips = load()
    tracked = {c["path"] for c in clips if c["status"] in ("new", "kept")}
    for c in clips:  # unreviewed clips in the archive queue
        p = Path(c["path"])
        if c["status"] == "new" and c["time"] < cutoff:
            if p.exists():
                size += p.stat().st_size
                to_trash(p)
                gone.append(p.name)
            if c.get("thumb"):
                Path(c["thumb"]).unlink(missing_ok=True)
            c["status"] = "expired"
    save(clips)
    loose = [p for p in CLIPS.glob("*.mp4") if str(p) not in tracked]  # never ingested
    loose += list(EXPORT.glob("*.mp4")) if EXPORT.exists() else []     # share copies
    for p in loose:
        try:
            st = p.stat()
        except OSError:
            continue
        if st.st_mtime < cutoff:
            size += st.st_size
            to_trash(p)
            gone.append(p.name)
    cmd_sync()   # hourly: also retries anything that couldn't reach the home server
    purged, freed = purge_trashed_clips(clips_conf("trash_days", 7))
    if purged:
        print(f"emptied {purged} clip{'s' if purged != 1 else ''} from the trash (>{clips_conf('trash_days', 7):g} d) · {freed / 2**20:.0f} MB")
    if gone:
        signal()
        msg = f"{len(gone)} clip{'s' if len(gone) != 1 else ''} older than {days:g} d moved to trash · {size / 2**20:.0f} MB"
        notify("Clip retention", msg + " · Kept/ untouched")
        print(msg)
        for n in gone:
            print("  ", n)
    else:
        print(f"nothing older than {days:g} d to prune")


def find_eww_config():
    """CLIPPER_EWW, else your own eww config if it defines a `clipper` window, else the bundled one."""
    if os.environ.get("CLIPPER_EWW"):
        return Path(os.environ["CLIPPER_EWW"]).expanduser()
    for folder in [XDG_CONFIG / "eww", *sorted(XDG_CONFIG.glob("*/eww"))]:
        try:
            if "defwindow clipper" in (folder / "eww.yuck").read_text(errors="replace"):
                return folder
        except OSError:
            pass
    return ROOT / "eww"


EWW_CFG = find_eww_config()


def eww(*args):
